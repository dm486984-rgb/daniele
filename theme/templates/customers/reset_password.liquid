<div class="section"><div class="page-width page-width--form">
  <h1>{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password', class: 'form' -%}
    {{ form.errors | default_errors }}
    <div class="form__row"><label for="ResetPassword">{{ 'customer.login.password' | t }}</label><input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password"></div>
    <div class="form__row"><label for="ResetPasswordConfirm">{{ 'customer.activate.password_confirm' | t }}</label><input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password"></div>
    <button type="submit" class="button button--full">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</div></div>
