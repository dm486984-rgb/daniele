<div class="section"><div class="page-width page-width--form">
  <h1>{{ 'customer.activate.title' | t }}</h1>
  <p>{{ 'customer.activate.info' | t }}</p>
  {%- form 'activate_customer_password', class: 'form' -%}
    {{ form.errors | default_errors }}
    <div class="form__row"><label for="ActivatePassword">{{ 'customer.login.password' | t }}</label><input type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password"></div>
    <div class="form__row"><label for="ActivatePasswordConfirm">{{ 'customer.activate.password_confirm' | t }}</label><input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password"></div>
    <button type="submit" class="button button--full">{{ 'customer.activate.submit' | t }}</button>
    <button type="submit" name="decline" class="link">{{ 'customer.activate.decline' | t }}</button>
  {%- endform -%}
</div></div>
