<div class="section"><div class="page-width page-width--form">
  <h1>{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer', class: 'form' -%}
    {{ form.errors | default_errors }}
    <div class="form__row"><label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label><input type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name"></div>
    <div class="form__row"><label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label><input type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name"></div>
    <div class="form__row"><label for="RegisterEmail">{{ 'customer.login.email' | t }}</label><input type="email" name="customer[email]" id="RegisterEmail" required autocomplete="email"></div>
    <div class="form__row"><label for="RegisterPassword">{{ 'customer.login.password' | t }}</label><input type="password" name="customer[password]" id="RegisterPassword" required autocomplete="new-password"></div>
    <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</div></div>
