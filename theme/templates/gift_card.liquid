{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
  {% render 'css-variables' %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body>
  <main class="section"><div class="page-width page-width--form text-center gift-card">
    <h1>{{ shop.name }}</h1>
    <h2>{{ 'gift_card.title' | t }}</h2>
    <p class="gift-card__balance">{{ gift_card.balance | money }}</p>
    {%- if gift_card.expired -%}<p class="badge">{{ 'gift_card.expired' | t }}</p>{%- endif -%}
    {%- unless gift_card.enabled -%}<p class="badge">{{ 'gift_card.disabled' | t }}</p>{%- endunless -%}
    <p>{{ 'gift_card.code' | t }}: <strong>{{ gift_card.code | format_code }}</strong></p>
    <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
    <p>
      <a href="{{ shop.url }}" class="button">{{ 'gift_card.shop' | t }}</a>
      <button type="button" class="button button--secondary" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
    </p>
  </div></main>
  <script>
    window.addEventListener('load', function () {
      var el = document.getElementById('QrCode');
      if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
    });
  </script>
</body>
</html>
