{%- if settings.cart_type == 'drawer' -%}
  <div class="cart-drawer" data-cart-drawer aria-hidden="true">
    <div class="cart-drawer__overlay" data-cart-close></div>
    <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
      <div class="cart-drawer__header">
        <h2 class="h4">{{ 'cart.title' | t }}</h2>
        <button type="button" class="header__icon" data-cart-close aria-label="{{ 'general.close' | t }}">{% render 'icon', icon: 'close' %}</button>
      </div>
      <div class="cart-drawer__body" data-cart-drawer-body>
        {% render 'cart-drawer-content' %}
      </div>
    </aside>
  </div>
{%- endif -%}
