{%- comment -%}
  Uso: {% render 'price', product: product %} oppure {% render 'price', product: product, variant: variant, show_badge: true %}
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare_at = target.compare_at_price
  assign on_sale = false
  if compare_at > price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--on-sale{% endif %}" data-price>
  {%- if variant == blank and product.price_varies -%}
    {%- assign price_min = product.price_min | money -%}
    <span class="price__current">{{ 'products.product.from_price' | t: price: price_min }}</span>
  {%- else -%}
    <span class="visually-hidden">{% if on_sale %}{{ 'products.product.sale_price' | t }}{% else %}{{ 'products.product.regular_price' | t }}{% endif %}</span>
    <span class="price__current">{{ price | money }}</span>
    {%- if on_sale -%}
      <s class="price__compare"><span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>{{ compare_at | money }}</s>
      {%- if show_badge -%}
        {%- assign saving = compare_at | minus: price | money -%}
        <span class="badge badge--sale">{{ 'products.product.save' | t: amount: saving }}</span>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
  {%- if target.unit_price_measurement -%}
    <small class="price__unit">
      {{ target.unit_price | money }}/{%- if target.unit_price_measurement.reference_value != 1 -%}{{ target.unit_price_measurement.reference_value }}{%- endif -%}{{ target.unit_price_measurement.reference_unit }}
    </small>
  {%- endif -%}
</div>
