{%- comment -%} Contenuto del carrello laterale: ricaricato via Section Rendering API (sezione 'cart-drawer-content') {%- endcomment -%}
{% render 'free-shipping-bar' %}
{%- if cart.item_count == 0 -%}
  <div class="cart-drawer__empty">
    <p>{{ 'cart.empty' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.continue_shopping' | t }}</a>
  </div>
{%- else -%}
  <ul class="cart-items">
    {%- for item in cart.items -%}
      <li class="cart-item" data-line="{{ forloop.index }}">
        <a href="{{ item.url }}" class="cart-item__media">
          {%- if item.image -%}{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.title }}{%- endif -%}
        </a>
        <div class="cart-item__info">
          <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
          {%- unless item.product.has_only_default_variant -%}<p class="cart-item__variant">{{ item.variant.title }}</p>{%- endunless -%}
          {%- for property in item.properties -%}
            {%- unless property.last == blank or property.first contains '_' -%}<p class="cart-item__variant">{{ property.first }}: {{ property.last }}</p>{%- endunless -%}
          {%- endfor -%}
          <div class="cart-item__row">
            <div class="quantity">
              <button type="button" data-qty-change="{{ item.quantity | minus: 1 }}" data-line="{{ forloop.index }}" aria-label="{{ 'accessibility.decrease_quantity' | t }}">{% render 'icon', icon: 'minus' %}</button>
              <span>{{ item.quantity }}</span>
              <button type="button" data-qty-change="{{ item.quantity | plus: 1 }}" data-line="{{ forloop.index }}" aria-label="{{ 'accessibility.increase_quantity' | t }}">{% render 'icon', icon: 'plus' %}</button>
            </div>
            <div class="cart-item__price">
              {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
              <span>{{ item.final_line_price | money }}</span>
            </div>
          </div>
          <button type="button" class="link cart-item__remove" data-qty-change="0" data-line="{{ forloop.index }}">{{ 'cart.remove' | t }}</button>
        </div>
      </li>
    {%- endfor -%}
  </ul>
  <div class="cart-drawer__footer">
    <div class="cart-drawer__subtotal">
      <span>{{ 'cart.subtotal' | t }}</span>
      <strong>{{ cart.total_price | money_with_currency }}</strong>
    </div>
    <p class="cart-drawer__note">{{ 'cart.taxes_and_shipping' | t }}</p>
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="button button--full button--large">{{ 'cart.checkout' | t }}</button>
    </form>
  </div>
{%- endif -%}
