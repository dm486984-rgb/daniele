{%- if settings.free_shipping_threshold != blank -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100 | times: cart.currency_rate | round
    assign remaining = threshold | minus: cart.total_price
    assign percent = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
  -%}
  <div class="free-shipping">
    <p>
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'cart.free_shipping_unlocked' | t }}
      {%- endif -%}
    </p>
    <div class="free-shipping__bar"><span style="width: {{ percent }}%"></span></div>
  </div>
{%- endif -%}
