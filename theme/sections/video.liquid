<section class="section video-section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 class="section__title text-center">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="video-section__wrapper video-section__wrapper--{{ section.settings.ratio }}">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: section.settings.autoplay, loop: section.settings.autoplay, muted: section.settings.autoplay, controls: section.settings.controls, playsinline: true, image_size: '1200x' }}
      {%- elsif section.settings.video_url != blank -%}
        {%- if section.settings.video_url.type == 'youtube' -%}
          <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?rel=0" title="{{ section.settings.heading | escape }}" loading="lazy" allow="autoplay; encrypted-media" allowfullscreen></iframe>
        {%- else -%}
          <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}" title="{{ section.settings.heading | escape }}" loading="lazy" allow="autoplay; fullscreen" allowfullscreen></iframe>
        {%- endif -%}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    {%- if section.settings.text != blank -%}<div class="rte text-center video-section__text">{{ section.settings.text }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Video",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Guarda come funziona" },
    { "type": "video", "id": "video", "label": "Video caricato su Shopify" },
    { "type": "video_url", "id": "video_url", "label": "Oppure link YouTube/Vimeo", "accept": ["youtube", "vimeo"] },
    { "type": "select", "id": "ratio", "label": "Formato", "options": [ { "value": "landscape", "label": "16:9" }, { "value": "square", "label": "1:1" }, { "value": "portrait", "label": "9:16 (verticale)" } ], "default": "landscape" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay muto in loop", "default": true },
    { "type": "checkbox", "id": "controls", "label": "Mostra controlli", "default": false },
    { "type": "richtext", "id": "text", "label": "Testo sotto il video" },
    { "type": "checkbox", "id": "alt_bg", "label": "Sfondo alternativo", "default": false }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}
