<section class="section featured-collection{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    <div class="section__header">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.collection != blank and section.settings.show_view_all -%}
        <a href="{{ section.settings.collection.url }}" class="link">{{ 'general.view_all' | t }}</a>
      {%- endif -%}
    </div>
    <div class="product-grid product-grid--{{ section.settings.columns }}">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <div class="product-card">
            <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
            <div class="product-card__info"><span class="product-card__title">Nome prodotto</span><div class="price"><span class="price__current">{{ 1999 | money }}</span></div></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collezione in evidenza",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "I più amati" },
    { "type": "collection", "id": "collection", "label": "Collezione" },
    { "type": "range", "id": "limit", "label": "Numero prodotti", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Colonne desktop", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostra 'Vedi tutto'", "default": true },
    { "type": "checkbox", "id": "alt_bg", "label": "Sfondo alternativo", "default": false }
  ],
  "presets": [{ "name": "Collezione in evidenza" }]
}
{% endschema %}
