{%- liquid
  assign overlay = section.settings.overlay | divided_by: 100.0
-%}
<section class="hero hero--{{ section.settings.height }} hero--align-{{ section.settings.alignment }}" style="--hero-overlay: {{ overlay }}; --hero-fg: {{ section.settings.text_color }};">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
        widths: '750, 1100, 1500, 1800, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        class: 'hero__image hero__image--desktop'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder hero__image' }}
    {%- endif -%}
    {%- if section.settings.image_mobile != blank -%}
      {{ section.settings.image_mobile | image_url: width: 1100 | image_tag:
        widths: '500, 750, 1100',
        sizes: '100vw',
        loading: 'eager',
        class: 'hero__image hero__image--mobile'
      }}
    {%- endif -%}
  </div>
  <div class="page-width hero__content">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="hero__heading">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="hero__text rte">{{ section.settings.text }}</div>{%- endif -%}
    <div class="hero__buttons">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button--large">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a href="{{ section.settings.button2_link }}" class="button button--secondary button--large">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.show_rating -%}
      <p class="hero__rating">
        <span class="stars">{% for i in (1..5) %}{% render 'icon', icon: 'star' %}{% endfor %}</span>
        {{ section.settings.rating_text }}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero / Banner",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Immagine desktop" },
    { "type": "image_picker", "id": "image_mobile", "label": "Immagine mobile (opzionale)" },
    { "type": "range", "id": "overlay", "label": "Oscuramento immagine", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "select", "id": "height", "label": "Altezza", "options": [ { "value": "small", "label": "Piccola" }, { "value": "medium", "label": "Media" }, { "value": "large", "label": "Grande" } ], "default": "large" },
    { "type": "select", "id": "alignment", "label": "Allineamento testo", "options": [ { "value": "left", "label": "Sinistra" }, { "value": "center", "label": "Centro" } ], "default": "left" },
    { "type": "color", "id": "text_color", "label": "Colore testo", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Sopratitolo", "default": "Nuova collezione" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Il prodotto che stavi aspettando" },
    { "type": "richtext", "id": "text", "label": "Testo", "default": "<p>Una frase che spiega il beneficio principale in modo chiaro e diretto.</p>" },
    { "type": "text", "id": "button_label", "label": "Bottone principale", "default": "Acquista ora" },
    { "type": "url", "id": "button_link", "label": "Link bottone principale" },
    { "type": "text", "id": "button2_label", "label": "Bottone secondario" },
    { "type": "url", "id": "button2_link", "label": "Link bottone secondario" },
    { "type": "checkbox", "id": "show_rating", "label": "Mostra stelline", "default": true },
    { "type": "text", "id": "rating_text", "label": "Testo valutazione", "default": "4.9/5 da oltre 1.000 clienti" }
  ],
  "presets": [{ "name": "Hero / Banner" }]
}
{% endschema %}
