<section class="section faq{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}<h2 class="section__title text-center">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="accordion">
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="accordion__title">{{ block.settings.question }}<span class="accordion__icon">{% render 'icon', icon: 'plus' %}</span></summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%} Dati strutturati FAQ per Google {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Domande frequenti" },
    { "type": "checkbox", "id": "open_first", "label": "Prima domanda aperta", "default": false },
    { "type": "checkbox", "id": "alt_bg", "label": "Sfondo alternativo", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Domanda",
      "settings": [
        { "type": "text", "id": "question", "label": "Domanda", "default": "Quanto tempo ci mette la spedizione?" },
        { "type": "richtext", "id": "answer", "label": "Risposta", "default": "<p>Spediamo entro 24h; la consegna richiede 2-4 giorni lavorativi.</p>" }
      ]
    }
  ],
  "presets": [{
    "name": "FAQ",
    "blocks": [
      { "type": "question", "settings": { "question": "Quanto tempo ci mette la spedizione?" } },
      { "type": "question", "settings": { "question": "Posso restituire il prodotto?", "answer": "<p>Sì, hai 30 giorni per il reso gratuito.</p>" } },
      { "type": "question", "settings": { "question": "Quali metodi di pagamento accettate?", "answer": "<p>Carte di credito, PayPal, Apple Pay, Google Pay e Klarna.</p>" } }
    ]
  }]
}
{% endschema %}
