<section class="section main-search">
  <div class="page-width">
    <h1 class="section__title">{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'search.title' | t }}">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="button">{{ 'general.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results_count == 0 -%}
          <p class="text-center">{{ 'search.no_results' | t: terms: search.terms }}</p>
        {%- else -%}
          <p>{{ 'search.results_for' | t: terms: search.terms }}</p>
          <div class="product-grid product-grid--4">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <a href="{{ item.url }}" class="search-result">
                  <h2 class="h4">{{ item.title }}</h2>
                  <p>{{ item.content | strip_html | truncatewords: 20 }}</p>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Ricerca", "settings": [] }
{% endschema %}
