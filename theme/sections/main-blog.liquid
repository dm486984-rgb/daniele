{%- paginate blog.articles by 9 -%}
<section class="section">
  <div class="page-width">
    <h1 class="section__title">{{ blog.title }}</h1>
    <div class="product-grid product-grid--3">
      {%- for article in blog.articles -%}
        <article class="article-card">
          <a href="{{ article.url }}" class="article-card__media">
            {%- if article.image -%}
              {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 100vw' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </a>
          <p class="article-card__date">{{ article.published_at | time_tag: format: 'date' }}</p>
          <h2 class="h4"><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
          <a href="{{ article.url }}" class="link">{{ 'blogs.read_more' | t }}</a>
        </article>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
