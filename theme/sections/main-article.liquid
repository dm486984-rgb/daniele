<article class="section main-article">
  <div class="page-width page-width--narrow">
    <a href="{{ blog.url }}" class="link">&larr; {{ 'blogs.back' | t }}</a>
    <h1 class="section__title">{{ article.title }}</h1>
    <p class="article-card__date">{{ article.published_at | time_tag: format: 'date' }} · {{ article.author }}</p>
    {%- if article.image -%}
      <div class="main-article__image">
        {{ article.image | image_url: width: 1400 | image_tag: widths: '600, 900, 1400', sizes: '(min-width: 990px) 800px, 100vw' }}
      </div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{ "name": "Articolo", "settings": [] }
{% endschema %}
