<section class="section">
  <div class="page-width">
    <h1 class="section__title">{{ section.settings.title }}</h1>
    <div class="product-grid product-grid--3">
      {%- for collection in collections -%}
        {%- if collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        <a href="{{ collection.url }}" class="collection-card">
          <div class="collection-card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 50vw' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <h2 class="collection-card__title">{{ collection.title }}</h2>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lista collezioni",
  "settings": [ { "type": "text", "id": "title", "label": "Titolo", "default": "Collezioni" } ]
}
{% endschema %}
