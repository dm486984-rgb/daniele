<section class="section newsletter section--primary">
  <div class="page-width page-width--narrow text-center">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {% render 'newsletter-form', form_id: 'section-newsletter' %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "-10% sul primo ordine" },
    { "type": "richtext", "id": "text", "label": "Testo", "default": "<p>Iscriviti e ricevi subito il codice sconto.</p>" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
