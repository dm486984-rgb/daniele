<section class="section main-cart">
  <div class="page-width page-width--narrow">
    <h1 class="section__title">{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count == 0 -%}
      <div class="text-center">
        <p>{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      {% render 'free-shipping-bar' %}
      <form action="{{ routes.cart_url }}" method="post" class="cart-form">
        <ul class="cart-items">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a href="{{ item.url }}" class="cart-item__media">
                {%- if item.image -%}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.title }}{%- endif -%}
              </a>
              <div class="cart-item__info">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="cart-item__variant">{{ item.variant.title }}</p>{%- endunless -%}
                <div class="cart-item__row">
                  <label class="visually-hidden" for="updates_{{ item.key }}">{{ 'products.product.quantity' | t }}</label>
                  <input class="cart-item__qty" type="number" id="updates_{{ item.key }}" name="updates[]" value="{{ item.quantity }}" min="0">
                  <div class="cart-item__price">
                    {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                    <span>{{ item.final_line_price | money }}</span>
                  </div>
                </div>
                <a href="{{ item.url_to_remove }}" class="link cart-item__remove">{{ 'cart.remove' | t }}</a>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.show_note -%}
          <label for="CartNote" class="cart-note__label">{{ 'cart.note' | t }}</label>
          <textarea id="CartNote" name="note" class="cart-note">{{ cart.note }}</textarea>
        {%- endif -%}

        <div class="cart-summary">
          <div class="cart-drawer__subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money_with_currency }}</strong>
          </div>
          <p class="cart-drawer__note">{{ 'cart.taxes_and_shipping' | t }}</p>
          <div class="cart-summary__buttons">
            <button type="submit" name="update" class="button button--secondary">Aggiorna</button>
            <button type="submit" name="checkout" class="button button--large">{{ 'cart.checkout' | t }}</button>
          </div>
          {%- if additional_checkout_buttons -%}
            <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Carrello",
  "settings": [ { "type": "checkbox", "id": "show_note", "label": "Mostra note ordine", "default": false } ]
}
{% endschema %}
