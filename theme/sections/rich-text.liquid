<section class="section rich-text{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width page-width--narrow text-{{ section.settings.alignment }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}<h2 {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}<div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}<a href="{{ block.settings.link }}" class="button" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Testo",
  "settings": [
    { "type": "select", "id": "alignment", "label": "Allineamento", "options": [ { "value": "left", "label": "Sinistra" }, { "value": "center", "label": "Centro" } ], "default": "center" },
    { "type": "checkbox", "id": "alt_bg", "label": "Sfondo alternativo", "default": false }
  ],
  "blocks": [
    { "type": "heading", "name": "Titolo", "settings": [ { "type": "text", "id": "heading", "label": "Titolo", "default": "La nostra missione" } ] },
    { "type": "text", "name": "Testo", "settings": [ { "type": "richtext", "id": "text", "label": "Testo", "default": "<p>Scrivi qui un messaggio per i tuoi clienti.</p>" } ] },
    { "type": "button", "name": "Bottone", "settings": [ { "type": "text", "id": "label", "label": "Testo", "default": "Scopri di più" }, { "type": "url", "id": "link", "label": "Link" } ] }
  ],
  "presets": [{ "name": "Testo", "blocks": [ { "type": "heading" }, { "type": "text" } ] }]
}
{% endschema %}
