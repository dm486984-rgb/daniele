<section class="password">
  <div class="password__box text-center">
    <h1>{{ shop.name }}</h1>
    <p class="eyebrow">{{ 'general.password_page.coming_soon' | t }}</p>
    {%- if shop.password_message != blank -%}<div class="rte">{{ shop.password_message }}</div>{%- endif -%}
    {% render 'newsletter-form', form_id: 'password-newsletter' %}

    <details class="password__login">
      <summary class="link">{{ 'general.password_page.login_form_heading' | t }}</summary>
      {%- form 'storefront_password', class: 'form' -%}
        {%- if form.errors -%}<p class="form-error">{{ 'general.password_page.login_form_error' | t }}</p>{%- endif -%}
        <label for="Password" class="visually-hidden">{{ 'general.password_page.login_form_password_label' | t }}</label>
        <div class="newsletter-form__field">
          <input type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'general.password_page.login_form_password_label' | t }}">
          <button type="submit" class="button">{{ 'general.password_page.login_password_button' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
