<section class="section image-text{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width image-text__grid{% if section.settings.image_right %} image-text__grid--reverse{% endif %}">
    <div class="image-text__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 750px) 50vw, 100vw' }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    <div class="image-text__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.blocks.size > 0 -%}
        <ul class="checklist">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'icon', icon: 'check' %}<span>{{ block.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Immagine con testo",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Immagine" },
    { "type": "checkbox", "id": "image_right", "label": "Immagine a destra", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Sopratitolo" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Perché sceglierci" },
    { "type": "richtext", "id": "text", "label": "Testo", "default": "<p>Racconta la storia del prodotto, come nasce e perché è diverso dagli altri.</p>" },
    { "type": "text", "id": "button_label", "label": "Testo bottone" },
    { "type": "url", "id": "button_link", "label": "Link bottone" },
    { "type": "checkbox", "id": "alt_bg", "label": "Sfondo alternativo", "default": false }
  ],
  "blocks": [
    { "type": "point", "name": "Punto elenco", "settings": [ { "type": "text", "id": "text", "label": "Testo", "default": "Beneficio chiave" } ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Immagine con testo", "blocks": [ { "type": "point" }, { "type": "point" }, { "type": "point" } ] }]
}
{% endschema %}
