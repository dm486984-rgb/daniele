{%- comment -%}
  Sezione "Storia prodotto": righe immagine + testo, griglia taglie, chiusura CTA.
  Mobile: immagine → testo (centrato, come una landing).
  Desktop: foto → testo in colonna centrata (oppure affiancati, da impostazioni).
  Autonoma: funziona anche incollata in altri temi (es. Dawn).
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign row_index = 0
-%}

{% style %}
  #ps-{{ sid }} {
    --ps-bg: {{ section.settings.bg }};
    --ps-text: {{ section.settings.text_color }};
    --ps-highlight: {{ section.settings.highlight_color }};
    --ps-gold: {{ section.settings.gold_color }};
    --ps-img-bg: {{ section.settings.image_bg }};
    --ps-radius: {{ section.settings.radius }}px;
    background: var(--ps-bg);
    color: var(--ps-text);
    padding: {{ section.settings.padding_mobile }}px 0;
  }
  #ps-{{ sid }} .ps__wrap { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  #ps-{{ sid }} .ps__row { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 24px; }
  #ps-{{ sid }} .ps__content { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  #ps-{{ sid }} .ps__row + .ps__row,
  #ps-{{ sid }} .ps__row + .ps__sizes,
  #ps-{{ sid }} .ps__sizes + .ps__row,
  #ps-{{ sid }} .ps__sizes + .ps__cta,
  #ps-{{ sid }} .ps__row + .ps__cta { margin-top: 56px; }

  #ps-{{ sid }} .ps__heading { margin: 0; font-size: 22px; line-height: 1.35; letter-spacing: .01em; color: var(--ps-text); }
  #ps-{{ sid }} .ps__text { font-size: 16px; line-height: 1.65; letter-spacing: .02em; }
  #ps-{{ sid }} .ps__text p { margin: 0 0 12px; }
  #ps-{{ sid }} .ps__text p:last-child { margin-bottom: 0; }
  #ps-{{ sid }} .ps__text strong { color: var(--ps-text); }
  #ps-{{ sid }} .ps__highlight { margin: 0; font-size: 17px; font-weight: 600; color: var(--ps-highlight); letter-spacing: .02em; }

  #ps-{{ sid }} .ps__media { width: 100%; border-radius: var(--ps-radius); overflow: hidden; background: var(--ps-img-bg); }
  #ps-{{ sid }} .ps__media img,
  #ps-{{ sid }} .ps__media svg { display: block; width: 100%; height: auto; }

  #ps-{{ sid }} .ps__bullets { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; text-align: left; width: 100%; max-width: 420px; }
  #ps-{{ sid }} .ps__bullets li { display: flex; align-items: flex-start; gap: 10px; font-size: 15px; line-height: 1.5; }
  #ps-{{ sid }} .ps__bullets svg { flex: 0 0 20px; width: 20px; height: 20px; margin-top: 1px; color: var(--ps-gold); }

  /* Taglie */
  #ps-{{ sid }} .ps__sizes { background: var(--ps-img-bg); border-radius: var(--ps-radius); padding: 28px 16px 32px; text-align: center; }
  #ps-{{ sid }} .ps__sizes-title { margin: 0 0 24px; font-size: 20px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; color: var(--ps-gold); }
  #ps-{{ sid }} .ps__sizes-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 22px 28px; }
  #ps-{{ sid }} .ps__size { flex: 0 0 calc(50% - 14px); max-width: 200px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  #ps-{{ sid }} .ps__size-img { width: 100%; aspect-ratio: 1; border-radius: 50%; overflow: hidden; border: 4px solid var(--ps-gold); background: #fff; }
  #ps-{{ sid }} .ps__size-img img,
  #ps-{{ sid }} .ps__size-img svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  #ps-{{ sid }} .ps__size-label { font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--ps-gold); }

  /* Chiusura */
  #ps-{{ sid }} .ps__cta { text-align: center; }
  #ps-{{ sid }} .ps__cta-text { margin: 0 auto; max-width: 760px; font-size: 19px; line-height: 1.45; font-weight: 800; text-transform: uppercase; letter-spacing: .03em; }
  #ps-{{ sid }} .ps__cta-btn { display: inline-block; margin-top: 22px; padding: 16px 38px; border-radius: 999px; background: var(--ps-gold); color: #fff; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; text-decoration: none; transition: transform .15s ease, box-shadow .15s ease; }
  #ps-{{ sid }} .ps__cta-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(0,0,0,.15); }

  /* Animazione leggera all'entrata */
  @media (prefers-reduced-motion: no-preference) {
    #ps-{{ sid }} [data-ps-reveal] { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
    #ps-{{ sid }} [data-ps-reveal].is-visible { opacity: 1; transform: none; }
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 750px) {
    #ps-{{ sid }} { padding: {{ section.settings.padding_desktop }}px 0; }
    #ps-{{ sid }} .ps__wrap { padding: 0 40px; }
    {%- if section.settings.desktop_layout == 'side' -%}
    #ps-{{ sid }} .ps__row { display: grid; grid-template-columns: 1fr 1fr; align-items: center; column-gap: clamp(32px, 5vw, 72px); text-align: left; }
    #ps-{{ sid }} .ps__row--reverse .ps__media { order: 2; }
    #ps-{{ sid }} .ps__content { align-items: flex-start; gap: 18px; }
    #ps-{{ sid }} .ps__bullets { max-width: none; margin-top: 4px; }
    #ps-{{ sid }} .ps__highlight { padding-left: 14px; border-left: 3px solid var(--ps-highlight); }
    {%- else -%}
    #ps-{{ sid }} .ps__row { max-width: {{ section.settings.column_width }}px; margin-left: auto; margin-right: auto; gap: 32px; }
    #ps-{{ sid }} .ps__content { max-width: 680px; gap: 18px; }
    {%- endif -%}
    #ps-{{ sid }} .ps__row + .ps__row,
    #ps-{{ sid }} .ps__row + .ps__sizes,
    #ps-{{ sid }} .ps__sizes + .ps__row,
    #ps-{{ sid }} .ps__sizes + .ps__cta,
    #ps-{{ sid }} .ps__row + .ps__cta { margin-top: 96px; }
    #ps-{{ sid }} .ps__heading { font-size: 32px; line-height: 1.25; }
    #ps-{{ sid }} .ps__text { font-size: 17px; }
    #ps-{{ sid }} .ps__highlight { font-size: 19px; }
    #ps-{{ sid }} .ps__sizes { padding: 56px 40px 60px; }
    #ps-{{ sid }} .ps__sizes-title { font-size: 28px; margin-bottom: 40px; }
    #ps-{{ sid }} .ps__sizes-grid { flex-wrap: nowrap; gap: 56px; }
    #ps-{{ sid }} .ps__size { flex: 0 1 240px; max-width: 240px; }
    #ps-{{ sid }} .ps__size-label { font-size: 16px; }
    #ps-{{ sid }} .ps__cta-text { font-size: 28px; }
  }
{% endstyle %}

<section id="ps-{{ sid }}" class="ps">
  <div class="ps__wrap">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'row' -%}
          {%- liquid
            assign row_index = row_index | plus: 1
            assign reverse = false
            case block.settings.image_position
              when 'right'
                assign reverse = true
              when 'auto'
                assign mod = row_index | modulo: 2
                if mod == 0
                  assign reverse = true
                endif
            endcase
          -%}
          <div class="ps__row{% if reverse %} ps__row--reverse{% endif %}" data-ps-reveal {{ block.shopify_attributes }}>
            <div class="ps__media">
              {%- if block.settings.image != blank -%}
                {%- assign img_alt = block.settings.image.alt | default: block.settings.heading | default: block.settings.highlight | strip_html | escape -%}
                {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1400', sizes: '(min-width: 750px) 800px, calc(100vw - 40px)', alt: img_alt }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>

            <div class="ps__content">
              {%- if block.settings.heading != blank -%}<h2 class="ps__heading">{{ block.settings.heading }}</h2>{%- endif -%}
              {%- if block.settings.text_top != blank -%}<div class="ps__text">{{ block.settings.text_top }}</div>{%- endif -%}
              {%- if block.settings.highlight != blank -%}<p class="ps__highlight">{{ block.settings.highlight }}</p>{%- endif -%}
              {%- if block.settings.text_bottom != blank -%}<div class="ps__text">{{ block.settings.text_bottom }}</div>{%- endif -%}
              {%- if block.settings.bullets != blank -%}
                {%- assign bullet_lines = block.settings.bullets | newline_to_br | split: '<br />' -%}
                <ul class="ps__bullets">
                  {%- for line in bullet_lines -%}
                    {%- assign clean_line = line | strip -%}
                    {%- if clean_line != blank -%}
                      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>{{ clean_line }}</span></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </div>

        {%- when 'sizes' -%}
          <div class="ps__sizes" data-ps-reveal {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}<h3 class="ps__sizes-title">{{ block.settings.title }}</h3>{%- endif -%}
            <div class="ps__sizes-grid">
              {%- for i in (1..3) -%}
                {%- liquid
                  assign img_key = 'image_' | append: i
                  assign label_key = 'label_' | append: i
                  assign size_img = block.settings[img_key]
                  assign size_label = block.settings[label_key]
                  assign size_alt = size_label | escape
                -%}
                {%- if size_img != blank or size_label != blank -%}
                  <div class="ps__size">
                    <div class="ps__size-img">
                      {%- if size_img != blank -%}
                        {{ size_img | image_url: width: 500 | image_tag: loading: 'lazy', widths: '240, 360, 500', sizes: '(min-width: 750px) 240px, 45vw', alt: size_alt }}
                      {%- else -%}
                        {{ 'product-apparel-2' | placeholder_svg_tag }}
                      {%- endif -%}
                    </div>
                    <span class="ps__size-label">{{ size_label }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

        {%- when 'cta' -%}
          <div class="ps__cta" data-ps-reveal {{ block.shopify_attributes }}>
            {%- if block.settings.text != blank -%}<p class="ps__cta-text">{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              {%- if block.settings.button_link != blank -%}
                <a href="{{ block.settings.button_link }}" class="ps__cta-btn">{{ block.settings.button_label }}</a>
              {%- else -%}
                <a href="#" class="ps__cta-btn" data-ps-scroll-top>{{ block.settings.button_label }}</a>
              {%- endif -%}
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('ps-{{ sid }}');
    if (!root) return;
    var items = root.querySelectorAll('[data-ps-reveal]');
    if (!('IntersectionObserver' in window)) {
      items.forEach(function (el) { el.classList.add('is-visible'); });
    } else {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        });
      }, { threshold: 0.15 });
      items.forEach(function (el) { io.observe(el); });
    }
    // Bottone senza link: torna su al form "Aggiungi al carrello"
    root.querySelectorAll('[data-ps-scroll-top]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        var target = document.querySelector('form[action*="/cart/add"]') || document.body;
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Storia prodotto",
  "tag": "div",
  "class": "section-product-story",
  "settings": [
    { "type": "header", "content": "Colori" },
    { "type": "color", "id": "bg", "label": "Sfondo", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Testo", "default": "#1A1A1A" },
    { "type": "color", "id": "highlight_color", "label": "Testo evidenziato", "default": "#E5342B" },
    { "type": "color", "id": "gold_color", "label": "Oro (taglie, bottone)", "default": "#D4A256" },
    { "type": "color", "id": "image_bg", "label": "Sfondo dietro le immagini", "default": "#F2F2F2" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "desktop_layout", "label": "Layout desktop", "options": [
      { "value": "stack", "label": "Foto sopra, testo sotto" },
      { "value": "side", "label": "Foto e testo affiancati" }
    ], "default": "stack" },
    { "type": "range", "id": "column_width", "label": "Larghezza colonna (desktop)", "min": 500, "max": 1100, "step": 50, "unit": "px", "default": 800 },
    { "type": "range", "id": "radius", "label": "Arrotondamento immagini", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "padding_mobile", "label": "Spazio sopra/sotto (mobile)", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_desktop", "label": "Spazio sopra/sotto (desktop)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Immagine + testo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Immagine" },
        {
          "type": "select", "id": "image_position", "label": "Posizione immagine (solo layout affiancato)",
          "options": [
            { "value": "auto", "label": "Alternata (zig-zag)" },
            { "value": "left", "label": "Sinistra" },
            { "value": "right", "label": "Destra" }
          ],
          "default": "left"
        },
        { "type": "text", "id": "heading", "label": "Titolo" },
        { "type": "richtext", "id": "text_top", "label": "Testo" },
        { "type": "text", "id": "highlight", "label": "Frase evidenziata (rossa)" },
        { "type": "richtext", "id": "text_bottom", "label": "Testo dopo la frase evidenziata" },
        { "type": "textarea", "id": "bullets", "label": "Punti elenco (uno per riga)", "info": "Opzionale: appaiono con la spunta" }
      ]
    },
    {
      "type": "sizes",
      "name": "Taglie (3 cerchi)",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "title", "label": "Titolo", "default": "Adatta a ogni cane e razza" },
        { "type": "image_picker", "id": "image_1", "label": "Immagine 1" },
        { "type": "text", "id": "label_1", "label": "Etichetta 1", "default": "Cani piccoli" },
        { "type": "image_picker", "id": "image_2", "label": "Immagine 2" },
        { "type": "text", "id": "label_2", "label": "Etichetta 2", "default": "Cani medi" },
        { "type": "image_picker", "id": "image_3", "label": "Immagine 3" },
        { "type": "text", "id": "label_3", "label": "Etichetta 3", "default": "Cani grandi" }
      ]
    },
    {
      "type": "cta",
      "name": "Chiusura",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "text", "label": "Testo", "default": "Il comfort del tuo cane inizia con DoggyKings. Prendi la tua e rendi felice il tuo cane." },
        { "type": "text", "id": "button_label", "label": "Testo bottone", "default": "Acquista ora" },
        { "type": "url", "id": "button_link", "label": "Link bottone", "info": "Vuoto = torna al bottone 'Aggiungi al carrello'" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Storia prodotto",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "heading": "Il tuo migliore amico sarà elegante e alla moda con la sua nuova giacca!",
            "text_top": "<p>Proprio come la moda per noi, la giacca DoggyKings è stata creata perché il tuo cane possa essere alla moda quanto te.</p>"
          }
        },
        {
          "type": "row",
          "settings": {
            "text_top": "<p>Il materiale di altissima qualità che utilizziamo garantisce al tuo cane il massimo comfort.</p>",
            "highlight": "Pettorina integrata e facile da usare.",
            "text_bottom": "<p>La pettorina è integrata nella giacca, con robusti anelli a D per agganciare il guinzaglio: non ti servono altre pettorine o collari.</p>"
          }
        },
        {
          "type": "row",
          "settings": {
            "text_top": "<p>Esci al freddo con il tuo amico a quattro zampe? Basta strati su strati o pettorine da infilare nei buchi del cappotto. Con la nostra giacca: <strong>ZIP, CLIP e VIA!</strong></p>",
            "text_bottom": "<p>La morbida fodera in pile e il collo alto regolabile bloccano il vento e tengono al caldo il tuo cane, così potete esplorare all'aperto tutto l'anno, senza eccezioni!</p>",
            "bullets": "Pettorina riflettente integrata\nInterno caldo e imbottito\nZip facile da indossare\nIdrorepellente"
          }
        },
        { "type": "sizes" },
        { "type": "cta" }
      ]
    }
  ]
}
{% endschema %}
