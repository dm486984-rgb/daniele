[
  {
    "name": "theme_info",
    "theme_name": "Nuovo Brand",
    "theme_version": "1.0.0",
    "theme_author": "Daniele",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Colori",
    "settings": [
      { "type": "color", "id": "color_primary", "label": "Colore principale (bottoni, link)", "default": "#1F8A5F" },
      { "type": "color", "id": "color_primary_contrast", "label": "Testo sui bottoni", "default": "#FFFFFF" },
      { "type": "color", "id": "color_accent", "label": "Colore accento (badge, stelle)", "default": "#F2B33D" },
      { "type": "color", "id": "color_background", "label": "Sfondo", "default": "#FFFFFF" },
      { "type": "color", "id": "color_background_alt", "label": "Sfondo alternativo (sezioni)", "default": "#F2F7F4" },
      { "type": "color", "id": "color_text", "label": "Testo", "default": "#14231C" },
      { "type": "color", "id": "color_sale", "label": "Prezzo scontato", "default": "#D23F3F" }
    ]
  },
  {
    "name": "Tipografia",
    "settings": [
      { "type": "font_picker", "id": "type_heading_font", "label": "Font titoli", "default": "poppins_n7" },
      { "type": "font_picker", "id": "type_body_font", "label": "Font testo", "default": "inter_n4" }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Larghezza pagina", "min": 1000, "max": 1600, "step": 50, "unit": "px", "default": 1200 },
      { "type": "range", "id": "border_radius", "label": "Arrotondamento immagini e card", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 12 },
      { "type": "range", "id": "button_radius", "label": "Arrotondamento bottoni", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 40 }
    ]
  },
  {
    "name": "Carrello",
    "settings": [
      { "type": "select", "id": "cart_type", "label": "Tipo carrello", "options": [ { "value": "drawer", "label": "Cassetto laterale" }, { "value": "page", "label": "Pagina" } ], "default": "drawer" },
      { "type": "text", "id": "free_shipping_threshold", "label": "Soglia spedizione gratuita (es. 49)", "info": "Lascia vuoto per nascondere la barra di avanzamento" }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "32 x 32px .png" }
    ]
  }
]
