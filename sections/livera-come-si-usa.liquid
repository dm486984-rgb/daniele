<div class="lvu lvu--{{ section.id }}">
  <div class="lvu__wrap">

    {% if section.settings.title != blank or section.settings.title_accent != blank %}
      <h2 class="lvu__title">
        {% if section.settings.title_accent != blank %}
          <span class="lvu__title-accent">{{ section.settings.title_accent }}</span>
        {% endif %}
        {{ section.settings.title }}
      </h2>
    {% endif %}

    <div class="lvu__grid">
      {% for block in section.blocks %}
        <div class="lvu__item" {{ block.shopify_attributes }}>
          <div class="lvu__media">

            {% if block.settings.video != blank %}
              {{
                block.settings.video
                | video_tag:
                  image_size: '900x',
                  autoplay: false,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  preload: 'none'
              }}
            {% elsif block.settings.video_url != blank %}
              <video
                src="{{ block.settings.video_url }}"
                loop
                muted
                playsinline
                preload="none"
              ></video>
            {% elsif block.settings.poster != blank %}
              <img
                src="{{ block.settings.poster | image_url: width: 900 }}"
                alt="{{ section.settings.title | escape }}"
                loading="lazy"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}

          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</div>

<style>
  .lvu--{{ section.id }} {
    background:
      radial-gradient(
        ellipse 900px 420px at 50% 100%,
        rgba(138, 43, 226, 0.10),
        transparent 70%
      ),
      {{ section.settings.bg_color }};

    padding:
      {{ section.settings.padding_top }}px
      20px
      {{ section.settings.padding_bottom }}px;
  }

  .lvu--{{ section.id }} .lvu__wrap {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .lvu--{{ section.id }} .lvu__title {
    font-family: var(--font-body-family, inherit);
    font-size: 40px;
    font-weight: 500;
    text-align: center;
    line-height: 1.15;
    color: {{ section.settings.title_color }};
    margin: 0 0 44px;
  }

  .lvu--{{ section.id }} .lvu__title-accent {
    background: linear-gradient(90deg, #6D28D9, #A855F7);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: #6D28D9;
    -webkit-text-stroke-width: 0;
    filter: drop-shadow(0 0 18px rgba(160, 84, 236, 0.30));
  }

  .lvu--{{ section.id }} .lvu__grid {
    display: grid;
    grid-template-columns:
      repeat({{ section.blocks.size | at_most: 3 }}, minmax(0, 1fr));
    gap: 18px;
  }

  .lvu--{{ section.id }} .lvu__media {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.radius }}px;
    aspect-ratio: {{ section.settings.ratio }};
    background: {{ section.settings.bg_color }};
  }

  .lvu--{{ section.id }} .lvu__media video,
  .lvu--{{ section.id }} .lvu__media img,
  .lvu--{{ section.id }} .lvu__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lvu--{{ section.id }} .lvu__media img,
  .lvu--{{ section.id }} .lvu__media svg {
    opacity: 1;
  }

  /* Il video resta invisibile finché non ha davvero il primo fotogramma decodificato.
     Così non si vede più il salto anteprima JPEG -> video. */
  .lvu--{{ section.id }} .lvu__media video {
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .lvu--{{ section.id }} .lvu__media video.lvu-ready {
    opacity: 1;
  }

  .lvu--{{ section.id }} .lvu__media .video-wrapper,
  .lvu--{{ section.id }} .lvu__media deferred-media {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 749px) {
    .lvu--{{ section.id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    .lvu--{{ section.id }} .lvu__wrap {
      max-width: {{ section.settings.max_width_mobile }}px;
    }

    .lvu--{{ section.id }} .lvu__title {
      font-size: 30px;
      margin-bottom: 34px;
    }

    .lvu--{{ section.id }} .lvu__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>

<script>
(function() {

  /* ---- REGOLAZIONI ---- */
  const LVU_START_DELAY = 200;   /* ritardo in millisecondi prima di partire */
  const LVU_THRESHOLD   = 0.2;   /* quanto video deve essere visibile: 0.5 = meta' */
  const LVU_PRELOAD_MARGIN = '900px'; /* quanto prima iniziare a scaricare il video */
  const LVU_SAFETY_MS   = 4000;  /* se il video non si carica, mostralo comunque */
  /* --------------------- */

  function initLvuVideos() {

    const section = document.querySelector('.lvu--{{ section.id }}');
    if (!section) return;

    const videos = section.querySelectorAll('video');
    if (!videos.length) return;

    videos.forEach(function(video) {

      if (video.dataset.lvuInitialized === 'true') return;
      video.dataset.lvuInitialized = 'true';

      video.muted = true;
      video.setAttribute('muted', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.setAttribute('preload', 'none');

      /* Via l'anteprima JPEG generata da Shopify: e' lei che causava
         il cambio di colore quando partiva il video vero. */
      video.removeAttribute('poster');

      /* niente video.load() qui: il file si scarica solo quando serve */

    });


    /* mostra il video solo quando ha un fotogramma vero da disegnare */
    function mostraVideo(video) {
      if (video.classList.contains('lvu-ready')) return;
      video.classList.add('lvu-ready');
    }


    /* scarica il file e prepara il primo fotogramma */
    function scarica(video) {

      if (video.dataset.lvuLoading !== 'true') {
        video.dataset.lvuLoading = 'true';
        video.preload = 'auto';
        try { video.load(); } catch (e) {}

        video.addEventListener('loadeddata', function() { mostraVideo(video); }, { once: true });
        video.addEventListener('playing',    function() { mostraVideo(video); }, { once: true });

        /* rete lenta o errore: non lasciarlo invisibile per sempre */
        setTimeout(function() { mostraVideo(video); }, LVU_SAFETY_MS);
      }

      /* era gia' pronto */
      if (video.readyState >= 2) mostraVideo(video);

    }


    function startVideo(video) {

      video.muted = true;
      scarica(video);

      if (!video.paused) return;

      const playPromise = video.play();

      if (playPromise !== undefined && playPromise !== null) {
        playPromise.catch(function() {
          const retry = function() {
            video.muted = true;
            video.play().catch(function() {});
            document.removeEventListener('touchstart', retry);
            document.removeEventListener('click', retry);
          };
          document.addEventListener('touchstart', retry, { once: true, passive: true });
          document.addEventListener('click', retry, { once: true });
        });
      }

    }


    /* scarica in anticipo quando il video si avvicina allo schermo,
       cosi' quando arriva a video il primo fotogramma c'e' gia' */
    const preloader = new IntersectionObserver(

      function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          const video = entry.target;
          scarica(video);
          preloader.unobserve(video);
        });
      },

      { root: null, rootMargin: LVU_PRELOAD_MARGIN, threshold: 0 }

    );


    const observer = new IntersectionObserver(

      function(entries) {

        entries.forEach(function(entry) {

          const video = entry.target;

          if (entry.isIntersecting) {

            if (video.lvuExitTimer) {
              clearTimeout(video.lvuExitTimer);
              video.lvuExitTimer = null;
            }

            /* parte dopo il ritardo impostato sopra */
            if (!video.lvuStartTimer) {
              video.lvuStartTimer = setTimeout(function() {
                startVideo(video);
                video.lvuStartTimer = null;
              }, LVU_START_DELAY);
            }

          } else {

            /* esci prima del ritardo: la partenza viene annullata */
            if (video.lvuStartTimer) {
              clearTimeout(video.lvuStartTimer);
              video.lvuStartTimer = null;
            }

            if (video.lvuExitTimer) clearTimeout(video.lvuExitTimer);

            video.lvuExitTimer = setTimeout(function() {
              video.pause();
              video.lvuExitTimer = null;
            }, 400);

          }

        });

      },

      {
        root: null,
        rootMargin: '0px',
        threshold: LVU_THRESHOLD
      }

    );


    videos.forEach(function(video) {
      if (video.dataset.lvuObserved === 'true') return;
      video.dataset.lvuObserved = 'true';
      preloader.observe(video);
      observer.observe(video);
    });

  }


  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLvuVideos);
  } else {
    initLvuVideos();
  }

  document.addEventListener('shopify:section:load', initLvuVideos);

})();
</script>

{% schema %}
{
  "name": "Livèra · Come si usa",
  "tag": "section",

  "settings": [
    {
      "type": "text",
      "id": "title_accent",
      "label": "Titolo — parola in viola (all'inizio)",
      "default": "Semplicemente"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo — resto della frase",
      "default": "liscia e senza peli"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Larghezza su desktop",
      "min": 180,
      "max": 1180,
      "step": 10,
      "unit": "px",
      "default": 540
    },
    {
      "type": "range",
      "id": "max_width_mobile",
      "label": "Larghezza su mobile",
      "min": 200,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "header",
      "content": "Riquadro"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporzioni video",
      "default": "1 / 1",
      "options": [
        { "value": "1 / 1", "label": "Quadrato 1:1" },
        { "value": "4 / 5", "label": "Verticale 4:5" },
        { "value": "3 / 4", "label": "Verticale 3:4" },
        { "value": "9 / 16", "label": "Verticale 9:16" },
        { "value": "4 / 3", "label": "Orizzontale 4:3" }
      ]
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Angoli arrotondati",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colori e spazi"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Sfondo sezione",
      "default": "#F6F1FC"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Colore titolo",
      "default": "#17111F"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Spazio sopra",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Spazio sotto",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],

  "blocks": [
    {
      "type": "step",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video (caricato su Shopify)"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Oppure link diretto al file .mp4"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Immagine di anteprima / fallback"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Livèra · Come si usa",
      "blocks": [
        { "type": "step", "settings": {} }
      ]
    }
  ]
}
{% endschema %}
