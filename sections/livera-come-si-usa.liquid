<div class="lvu lvu--{{ section.id }}">
  <div class="lvu__wrap">

    {% if section.settings.title != blank %}
      <h2 class="lvu__title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="lvu__grid">
      {% for block in section.blocks %}
        <div class="lvu__item" {{ block.shopify_attributes }}>
          <div class="lvu__media">
            {% if block.settings.video != blank %}
              {{ block.settings.video | video_tag: image_size: '900x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
            {% elsif block.settings.video_url != blank %}
              <video src="{{ block.settings.video_url }}" autoplay loop muted playsinline preload="metadata"
                     {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 900 }}"{% endif %}></video>
            {% elsif block.settings.poster != blank %}
              <img src="{{ block.settings.poster | image_url: width: 900 }}" alt="{{ section.settings.title | escape }}" loading="lazy">
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</div>

<style>
  .lvu--{{ section.id }} {
    background: linear-gradient(180deg, #FFFFFF 0%, {{ section.settings.bg_color }} 100%);
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }
    .lvu--{{ section.id }} .lvu__wrap { max-width: 260px; margin: 0 auto; }
  .lvu--{{ section.id }} .lvu__title {
    font-size: 27px; font-weight: 500; text-align: center; line-height: 1.25;
    color: {{ section.settings.title_color }}; margin: 0 0 44px;
  }

  .lvu--{{ section.id }} .lvu__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 3 }}, minmax(0, 1fr));
    gap: 18px;
  }

  .lvu--{{ section.id }} .lvu__media {
    position: relative; overflow: hidden;
    border-radius: {{ section.settings.radius }}px;
    aspect-ratio: {{ section.settings.ratio }};
    background: #E7E3DE;
  }
  .lvu--{{ section.id }} .lvu__media video,
  .lvu--{{ section.id }} .lvu__media img,
  .lvu--{{ section.id }} .lvu__media svg {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .lvu--{{ section.id }} .lvu__media .video-wrapper,
  .lvu--{{ section.id }} .lvu__media deferred-media { width: 100%; height: 100%; display: block; }

  @media (max-width: 749px) {
    .lvu--{{ section.id }} { padding-left: 16px; padding-right: 16px; }
    .lvu--{{ section.id }} .lvu__wrap { max-width: {{ section.settings.max_width_mobile }}px; }
    .lvu--{{ section.id }} .lvu__title { font-size: 22px; margin-bottom: 34px; }
    .lvu--{{ section.id }} .lvu__grid { grid-template-columns: 1fr; gap: 16px; }
  }
</style>

{% schema %}
{
  "name": "Livèra · Come si usa",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Titolo", "default": "Semplicemente liscia e senza peli" },
    { "type": "range", "id": "max_width", "label": "Larghezza su desktop", "min": 180, "max": 1180, "step": 10, "unit": "px", "default": 220 },
    { "type": "range", "id": "max_width_mobile", "label": "Larghezza su mobile", "min": 200, "max": 600, "step": 10, "unit": "px", "default": 360 },
    { "type": "header", "content": "Riquadro" },
    {
      "type": "select", "id": "ratio", "label": "Proporzioni video", "default": "1 / 1",
      "options": [
        { "value": "1 / 1", "label": "Quadrato 1:1" },
        { "value": "4 / 5", "label": "Verticale 4:5" },
        { "value": "3 / 4", "label": "Verticale 3:4" },
        { "value": "9 / 16", "label": "Verticale 9:16" },
        { "value": "4 / 3", "label": "Orizzontale 4:3" }
      ]
    },
    { "type": "range", "id": "radius", "label": "Angoli arrotondati", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 4 },
    { "type": "header", "content": "Colori e spazi" },
    { "type": "color", "id": "bg_color", "label": "Sfondo sezione", "default": "#FAF7FE" },
    { "type": "color", "id": "title_color", "label": "Colore titolo", "default": "#17111F" },
    { "type": "range", "id": "padding_top", "label": "Spazio sopra", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Spazio sotto", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (caricato su Shopify)" },
        { "type": "text", "id": "video_url", "label": "Oppure link diretto al file .mp4" },
        { "type": "image_picker", "id": "poster", "label": "Immagine di anteprima / fallback" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Livèra · Come si usa",
      "blocks": [
        { "type": "step", "settings": {} }
      ]
    }
  ]
}
{% endschema %}
