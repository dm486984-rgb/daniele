{%- comment -%}
  CAROSELLO VIDEO (3 video grandi) – da incollare in un blocco "Liquid personalizzato".
  Metti i link dei tuoi video qui sotto, UNO PER RIGA (Contenuti → File → copia link).
{%- endcomment -%}
{%- capture vcb_list -%}
https://cdn.shopify.com/videos/c/o/v/f1be52ffd0eb4ddd9453bf6895d4ca6e.mp4
https://cdn.shopify.com/videos/c/o/v/2f9cc563189041b5ab4aef7536a88428.mp4
https://cdn.shopify.com/videos/c/o/v/bfd2c8ef002841ba8f7da72cb0c48503.mp4
{%- endcapture -%}
{%- assign vcb_videos = vcb_list | newline_to_br | split: '<br />' -%}

<style>
  .vcb { --vcb-gap: 8px; --vcb-per-view: 3; --vcb-arrow: #1F3B57; --vcb-radius: 12px; padding: 24px 0; overflow: hidden; }
  .vcb__slider { position: relative; max-width: 1200px; margin: 0 auto; padding: 0; }
  .vcb__track { display: flex; gap: var(--vcb-gap); overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .vcb__track::-webkit-scrollbar { display: none; }
  .vcb__item { flex: 0 0 calc((100% - (var(--vcb-per-view) - 1) * var(--vcb-gap)) / var(--vcb-per-view)); scroll-snap-align: start; position: relative; aspect-ratio: 9 / 16; border-radius: var(--vcb-radius); overflow: hidden; background: #e9e9e9; }
  .vcb__item video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
  .vcb__item video::-webkit-media-controls { display: none !important; }
  .vcb__arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 34px; height: 34px; border-radius: 50%; border: 0; padding: 0; cursor: pointer; display: grid; place-items: center; background: var(--vcb-arrow); color: #fff; box-shadow: 0 3px 10px rgba(0,0,0,.25); transition: opacity .2s, transform .2s; }
  .vcb__arrow:hover { transform: translateY(-50%) scale(1.06); }
  .vcb__arrow[disabled] { opacity: .35; cursor: default; }
  .vcb__arrow[hidden] { display: none; }
  .vcb__arrow svg { width: 16px; height: 16px; }
  .vcb__arrow--prev { left: 0; }
  .vcb__arrow--next { right: 0; }
  @media (min-width: 750px) {
    .vcb { --vcb-gap: 12px; --vcb-per-view: 3; --vcb-radius: 14px; padding: 32px 0; }
    .vcb__slider { padding: 0; }
    .vcb__arrow { width: 54px; height: 54px; }
    .vcb__arrow svg { width: 22px; height: 22px; }
    .vcb__arrow--prev { left: 6px; }
    .vcb__arrow--next { right: 6px; }
  }
</style>

<div class="vcb" data-vcb>
  <div class="vcb__slider">
    <button type="button" class="vcb__arrow vcb__arrow--prev" data-vcb-prev aria-label="Video precedente">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
    </button>
    <div class="vcb__track" data-vcb-track>
      {%- for url in vcb_videos -%}
        {%- assign clean_url = url | strip -%}
        {%- if clean_url != blank -%}
          <div class="vcb__item"><video src="{{ clean_url }}" autoplay loop muted playsinline preload="auto"></video></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <button type="button" class="vcb__arrow vcb__arrow--next" data-vcb-next aria-label="Video successivo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll('[data-vcb]:not([data-vcb-ready])').forEach(function (root) {
    root.setAttribute('data-vcb-ready', '');
    var track = root.querySelector('[data-vcb-track]');
    var prev = root.querySelector('[data-vcb-prev]');
    var next = root.querySelector('[data-vcb-next]');
    var videos = Array.prototype.slice.call(root.querySelectorAll('video'));

    videos.forEach(function (v) {
      v.muted = true; v.defaultMuted = true; v.loop = true; v.playsInline = true;
      v.setAttribute('muted', ''); v.setAttribute('playsinline', ''); v.setAttribute('webkit-playsinline', '');
      v.removeAttribute('controls'); v.controls = false;
    });

    var play = function (v) { var p = v.play(); if (p && p.catch) p.catch(function () {}); };
    var inView = false;

    // Un video è "visibile" se è dentro la parte visibile del carosello
    var visibleInTrack = function (v) {
      var t = track.getBoundingClientRect();
      var r = v.getBoundingClientRect();
      var w = Math.min(r.right, t.right) - Math.max(r.left, t.left);
      return w > r.width * 0.5;
    };
    var refresh = function () {
      videos.forEach(function (v) {
        if (inView && visibleInTrack(v)) { if (v.paused) play(v); }
        else if (!v.paused) v.pause();
      });
    };
    videos.forEach(function (v) {
      v.addEventListener('loadeddata', function () { if (inView && visibleInTrack(v)) play(v); });
    });

    // Partono tutti insieme quando il blocco entra nello schermo, si fermano quando esce
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        inView = entries[0].isIntersecting;
        refresh();
      }, { threshold: 0.25 }).observe(root);
    } else {
      inView = true;
      refresh();
    }

    track.addEventListener('click', function (e) {
      var item = e.target.closest('.vcb__item');
      var v = item && item.querySelector('video');
      if (v && v.paused) play(v);
    });

    var step = function () {
      var item = track.querySelector('.vcb__item');
      if (!item) return 0;
      var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;
      return item.getBoundingClientRect().width + gap;
    };
    var maxIndex = function () {
      var st = step();
      return st ? Math.max(0, Math.round((track.scrollWidth - track.clientWidth) / st)) : 0;
    };
    var index = 0;
    var settle;
    var update = function () {
      var max = track.scrollWidth - track.clientWidth - 2;
      var none = max <= 0;
      prev.hidden = none; next.hidden = none;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    };
    var go = function (dir) {
      index = Math.min(maxIndex(), Math.max(0, index + dir));
      var target = index >= maxIndex() ? track.scrollWidth : index * step();
      track.scrollTo({ left: target, behavior: 'smooth' });
    };
    prev.addEventListener('click', function () { go(-1); });
    next.addEventListener('click', function () { go(1); });
    track.addEventListener('scroll', function () {
      window.requestAnimationFrame(update);
      clearTimeout(settle);
      settle = setTimeout(function () { var st = step(); if (st) index = Math.min(maxIndex(), Math.round(track.scrollLeft / st)); refresh(); }, 150);
    }, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
